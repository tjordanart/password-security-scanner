import string  # Provides built-in collections of characters like punctuation
import time    # Used to create delays for the scanning animation


# Terminal color codes used to display results
RED = "\033[91m"
YELLOW = "\033[93m"
GREEN = "\033[92m"
RESET = "\033[0m"


# Controls the delay between each security check
SCAN_SPEED = 0.3


# Continue running until a password passes all security checks
while True:

    # Ask the user for a password to analyze
    password = input("\nEnter a password to test: ")


    # Simulate starting a security scan
    print("\nStarting security scan...")
    time.sleep(0.5)


    # Score tracks how many requirements the password passes
    score = 0

    # Stores the results of each individual security check
    results = []


    # -----------------------------
    # Check password length
    # -----------------------------

    print("Checking length...")
    time.sleep(SCAN_SPEED)

    # Strong passwords should contain at least 8 characters
    if len(password) >= 8:

        score += 1
        results.append(("Length: Pass", True))

    else:

        results.append(("Length: Too short", False))


    # -----------------------------
    # Check for uppercase letters
    # -----------------------------

    print("Checking uppercase letters...")
    time.sleep(SCAN_SPEED)

    # any() returns True if at least one character matches the condition
    if any(char.isupper() for char in password):

        score += 1
        results.append(("Uppercase letters: Pass", True))

    else:

        results.append(("Uppercase letters: Missing", False))


    # -----------------------------
    # Check for lowercase letters
    # -----------------------------

    print("Checking lowercase letters...")
    time.sleep(SCAN_SPEED)

    # Checks whether the password contains lowercase characters
    if any(char.islower() for char in password):

        score += 1
        results.append(("Lowercase letters: Pass", True))

    else:

        results.append(("Lowercase letters: Missing", False))


    # -----------------------------
    # Check for numbers
    # -----------------------------

    print("Checking numbers...")
    time.sleep(SCAN_SPEED)

    # Checks whether the password contains at least one digit
    if any(char.isdigit() for char in password):

        score += 1
        results.append(("Numbers: Pass", True))

    else:

        results.append(("Numbers: Missing", False))


    # -----------------------------
    # Check for special characters
    # -----------------------------

    print("Checking special characters...")
    time.sleep(SCAN_SPEED)

    # Checks whether the password contains symbols
    # such as !, @, #, $, %, etc.
    if any(char in string.punctuation for char in password):

        score += 1
        results.append(("Special characters: Pass", True))

    else:

        results.append(("Special characters: Missing", False))


    # Calculate the percentage score based on five requirements
    percentage = (score / 5) * 100


    # Display the results of each security check
    print("\nPassword Analysis")
    print("-----------------")


    for result, passed in results:

        # Green indicates a passed requirement
        if passed:

            print(GREEN + result + RESET)

        # Red indicates a failed requirement
        else:

            print(RED + result + RESET)


    print("-----------------")


    # Determine overall password strength rating
    if percentage <= 40:

        rating = "Weak"
        score_color = RED

    elif percentage <= 80:

        rating = "Medium"
        score_color = YELLOW

    else:

        rating = "Strong"
        score_color = GREEN


    # Display the final security rating
    print(f"Overall Rating: {score_color}{rating}{RESET}")
    print(f"Security Score: {score_color}{percentage:.0f}%{RESET}")


    # Only allow the program to end when all requirements pass
    if percentage == 100:

        print(GREEN + "\nPassword accepted. Security requirements met." + RESET)

        input("\nPress any key to continue...")

        break

    else:

        print(RED + "\nPassword does not meet security requirements." + RESET)
        print("Try a different password.")